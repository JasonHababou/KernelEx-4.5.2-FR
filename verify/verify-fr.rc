IDD_DIALOG1 DIALOG DISCARDABLE  0, 0, 296, 78
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KernelEx"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,122,57,50,14
    ICON            32516,IDC_STATIC,7,7,20,20
    LTEXT           "KernelEx a été installé avec succès et est maintenant activé pour toutes les applications.\nPour exécuter des applications récentes ou corriger les plantages d’anciennes applications, ouvrez l’onglet KernelEx dans les propriétés de l’exécutable ou de son raccourci.",
                    IDC_STATIC,36,7,253,34
    CONTROL         "Pour en savoir plus sur KernelEx, consultez le <a href=""http://kernelex.sourceforge.net/wiki/"">Wiki de KernelEx</a>",
                    IDC_LINK,"SysLink",WS_TABSTOP,36,39,253,10
    RTEXT           "VERSIONSTR",IDC_VERSION,224,62,65,9,WS_DISABLED
END

IDD_DIALOG2 DIALOG DISCARDABLE  0, 0, 296, 78
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KernelEx"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,122,57,50,14
    ICON            32516,IDC_STATIC,7,7,20,20
    LTEXT           "KernelEx a été installé avec succès, mais il est désactivé par défaut et activé uniquement pour certaines applications. Pour activer KernelEx pour les applications récentes, ouvrez l’onglet KernelEx dans les propriétés de l’exécutable ou de son raccourci.",
                    IDC_STATIC,36,7,253,34
    CONTROL         "Pour en savoir plus sur KernelEx, consultez le <a href=""http://kernelex.sourceforge.net/wiki/"">Wiki de KernelEx</a>",
                    IDC_LINK,"SysLink",WS_TABSTOP,36,39,253,10
    RTEXT           "VERSIONSTR",IDC_VERSION,224,62,65,9,WS_DISABLED
END


