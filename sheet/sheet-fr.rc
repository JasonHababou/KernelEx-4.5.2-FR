/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE DISCARDABLE 
BEGIN
    TIP_DEFAULT             "Utiliser pour ce module les paramètres par défaut définis lors de l’installation (entre crochets). Cette option permet de remplacer les paramètres de l’exécutable principal ou du processus parent."
    TIP_DISABLE             "Select this option to execute module as if KernelEx wasn't installed."
    TIP_COMPAT              "Choisissez le mode de compatibilité requis par l’application. Cette option permet de modifier l’identification du système d’exploitation et d’émuler le comportement d’autres systèmes."
    TIP_SYSTEM              "Sélectionnez le mode de compatibilité souhaité dans la liste."
    TIP_NOINHERIT           "Désactive l’héritage de ces paramètres. Normalement, les programmes lancés par cette application utilisent les paramètres de cet onglet par défaut. Utilisez cette option pour désactiver ce comportement."
    TIP_OVERRIDE            "Disables usage of per module settings. Use this option to use same settings for all modules in the application."
    TIP_HOOK                "Utilisez cette option pour activer le débogage du hook d’API."
    IDS_ENABLED             "KernelEx est activé"
    IDS_DISABLED            "KernelEx est désactivé"
END

